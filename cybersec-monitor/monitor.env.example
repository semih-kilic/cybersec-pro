# CyberSec Monitor environment variables
# Copy to /etc/cybersec/monitor.env and set secure permissions (600)

CYBERSEC_ALERT_WEBHOOK=
CYBERSEC_SMTP_SERVER=
CYBERSEC_SMTP_PORT=465
CYBERSEC_SMTP_EMAIL=
CYBERSEC_SMTP_PASSWORD=
CYBERSEC_SMTP_FROM_NAME=CyberSec Monitor
CYBERSEC_ALERT_EMAIL=
CYBERSEC_CHECK_INTERVAL=30
CYBERSEC_RESTART_COOLDOWN=30
CYBERSEC_MAX_RESTART_ATTEMPTS=8
CYBERSEC_FAILURE_THRESHOLD=4
CYBERSEC_ALERT_COOLDOWN=1200
CYBERSEC_HTTP_VERIFY=true
CYBERSEC_HTTP_TIMEOUT=10
CYBERSEC_HTTP_RETRIES=0
CYBERSEC_HTTP_BACKOFF=0.2
CYBERSEC_HTTP_POOL=10
CYBERSEC_SKIP_EXTERNAL=false
CYBERSEC_LOG_OK=true
CYBERSEC_SKIP_SERVICES=
CYBERSEC_JITTER_MAX=0
