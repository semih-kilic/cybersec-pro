[Unit]
Description=CyberSec Pro Service Manager & Monitor
After=network.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=notify
User=sam
Group=sam
WorkingDirectory=/home/sam/APPS/cybersec-monitor
Environment="PATH=/home/sam/bin:/home/sam/APPS/cybersec-sales/backend/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="HOME=/home/sam"
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=-/etc/cybersec/monitor.env
ExecStart=/home/sam/APPS/cybersec-sales/backend/venv/bin/python3 /home/sam/APPS/cybersec-monitor/service_manager.py --interval 30
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10
UMask=0077
TimeoutStartSec=30
TimeoutStopSec=20
LimitNOFILE=4096
LimitNPROC=512
Nice=10
OOMScoreAdjust=200
StandardOutput=append:/var/log/cybersec/monitor.log
StandardError=append:/var/log/cybersec/monitor.log
StateDirectory=cybersec
LogsDirectory=cybersec
StateDirectoryMode=0700
LogsDirectoryMode=0700

# Watchdog
WatchdogSec=30
NotifyAccess=main

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictSUIDSGID=true
RestrictNamespaces=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0077

[Install]
WantedBy=multi-user.target
