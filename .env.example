# 🛡️ CyberSec Pro - Production Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# Database Configuration
# ============================================
DB_PASSWORD=YourSecurePasswordHere2026!
DATABASE_URL=postgresql://cybersec:${DB_PASSWORD}@postgres:5432/cybersec_pro

# ============================================
# Security Keys (CHANGE THESE IN PRODUCTION!)
# ============================================
SECRET_KEY=your-super-secret-key-change-this-in-production-minimum-32-chars
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production-minimum-32-chars
ENCRYPTION_KEY=your-encryption-key-for-credentials-32chars
API_SECRET=your-kali-tools-api-secret-change-this-in-production-32chars

# ============================================
# Stripe Configuration
# ============================================
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# Price IDs for subscription plans — monthly
# Variable names used by the backend (STRIPE_*_PRICE_ID):
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PROFESSIONAL_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...

# Price IDs for yearly billing (optional — enables annual checkout)
STRIPE_STARTER_PRICE_ID_YEARLY=price_...
STRIPE_PROFESSIONAL_PRICE_ID_YEARLY=price_...
STRIPE_ENTERPRISE_PRICE_ID_YEARLY=price_...

# Legacy aliases (kept for backward-compat with older deploy scripts)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_TEAM=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ============================================
# OAuth Configuration
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://app.cyber-sec-pro.com/auth/google/callback

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=https://app.cyber-sec-pro.com/auth/github/callback

LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=https://app.cyber-sec-pro.com/auth/linkedin/callback

# ============================================
# Email Configuration (SMTP)
# ============================================
# NOTE: the code reads SMTP_SERVER, not SMTP_HOST (services/email.rs).
SMTP_SERVER=smtp.example.com
SMTP_PORT=465
# NOTE: the code reads SMTP_EMAIL, not SMTP_USER.
SMTP_EMAIL=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_NAME=CyberSec Pro
SMTP_FROM_EMAIL=noreply@cyber-sec-pro.com

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ============================================
# Application Settings
# ============================================
RUST_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# Domain configuration
FRONTEND_URL=https://app.cyber-sec-pro.com
BACKEND_URL=https://api.cyber-sec-pro.com
CORS_ORIGINS=https://cyber-sec-pro.com,https://app.cyber-sec-pro.com

# ============================================
# AI / LLM Configuration (Optional)
# ============================================
# Set OPENAI_API_KEY to enable LLM-enriched AI features (suggest-tools, playbook, explain).
# Without this, all AI endpoints work offline using the local keyword engine.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Ollama local LLM bridge (ai-bridge.js service on port 8765)
OLLAMA_HOST=http://127.0.0.1:11434
AI_BRIDGE_PORT=8765

# ============================================
# Scan Engine Configuration
# ============================================
SCAN_MAX_WORKERS=4
SCAN_USE_DOCKER=true
SCAN_DEFAULT_TIMEOUT=300

# Agent routing: set to "false" to force all scans to run server-side (ignore agent)
AGENT_ROUTING_ENABLED=true

# ============================================
# Purple Team / Detection Configuration (Optional)
# ============================================
# Set to enable detection signal integration
PURPLE_TEAM_DETECT_ENDPOINT=
PURPLE_TEAM_DETECT_API_KEY=

# ============================================
# Monitoring & Logging
# ============================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
ENABLE_METRICS=true

# ============================================
# Cloudflare Configuration (Optional)
# ============================================
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token

# ─────────────────────────────────────────────────────────────────────────
# Added 2026-08-29. These are read by the code but were missing from this
# template, so anyone setting the project up from it got a half-working
# install — most visibly, email silently did not send because the SMTP
# variables here did not match the names services/email.rs actually reads.
# ─────────────────────────────────────────────────────────────────────────

# Sender identity
SMTP_FROM=noreply@example.com

# Optional secondary SMTP provider, used when the primary fails (quota,
# outage). Leave SMTP_FALLBACK_PASSWORD empty to disable.
SMTP_FALLBACK_SERVER=
SMTP_FALLBACK_PORT=587
SMTP_FALLBACK_EMAIL=
SMTP_FALLBACK_PASSWORD=
SMTP_FALLBACK_FROM=
SMTP_FALLBACK_FROM_NAME=

# Secrets at rest (agent SSH credentials, SSO client secrets). Deliberately
# SEPARATE from JWT_SECRET_KEY: rotating the signing key is routine, and if the
# two were shared, rotating it would make every stored credential permanently
# undecryptable. Generate with: openssl rand -hex 48
ENCRYPTION_KEY=

# Password for the optional web terminal (advanced profile). Without it the
# terminal refuses to start; it used to run with no authentication at all.
TERMINAL_PASSWORD=

# Public hostname, used in emails and redirect URLs.
DOMAIN=example.com
FRONTEND_URL=https://app.example.com

# Where feedback submissions are delivered.
FEEDBACK_ADMIN_EMAIL=

# Stripe founding-member tier
STRIPE_FOUNDING_MEMBER_PRICE_ID=
STRIPE_FOUNDING_MEMBER_PRICE_ID_YEARLY=

# LLM provider. NVIDIA_API_KEY is tried first, then OPENAI_API_KEY.
NVIDIA_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Data retention (GDPR/PIPEDA storage limitation). OFF by default: switching it
# on deletes history older than the windows below on the first run.
DATA_RETENTION_ENABLED=false
SCAN_RETENTION_DAYS=30
LOG_RETENTION_DAYS=90

# Set to 1 only for local HTTP development — it drops the Secure flag from the
# refresh-token cookie.
COOKIE_INSECURE=0
