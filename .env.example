# 🛡️ CyberSec Pro - Production Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# Database Configuration
# ============================================
DB_PASSWORD=YourSecurePasswordHere2026!
DATABASE_URL=postgresql://cybersec:${DB_PASSWORD}@postgres:5432/cybersec_pro

# ============================================
# Security Keys (CHANGE THESE IN PRODUCTION!)
# ============================================
SECRET_KEY=your-super-secret-key-change-this-in-production-minimum-32-chars
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production-minimum-32-chars
ENCRYPTION_KEY=your-encryption-key-for-credentials-32chars
API_SECRET=your-kali-tools-api-secret-change-this-in-production-32chars

# ============================================
# Stripe Configuration
# ============================================
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# Price IDs for subscription plans — monthly
# Variable names used by the backend (STRIPE_*_PRICE_ID):
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PROFESSIONAL_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...

# Price IDs for yearly billing (optional — enables annual checkout)
STRIPE_STARTER_PRICE_ID_YEARLY=price_...
STRIPE_PROFESSIONAL_PRICE_ID_YEARLY=price_...
STRIPE_ENTERPRISE_PRICE_ID_YEARLY=price_...

# Legacy aliases (kept for backward-compat with older deploy scripts)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_TEAM=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ============================================
# OAuth Configuration
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://app.cyber-sec-pro.com/auth/google/callback

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=https://app.cyber-sec-pro.com/auth/github/callback

LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=https://app.cyber-sec-pro.com/auth/linkedin/callback

# ============================================
# Email Configuration (SMTP)
# ============================================
SMTP_HOST=smtp.yandex.com
SMTP_PORT=465
SMTP_USER=noreply@cyber-sec-pro.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_NAME=CyberSec Pro
SMTP_FROM_EMAIL=noreply@cyber-sec-pro.com

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ============================================
# Application Settings
# ============================================
RUST_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# Domain configuration
FRONTEND_URL=https://app.cyber-sec-pro.com
BACKEND_URL=https://api.cyber-sec-pro.com
CORS_ORIGINS=https://cyber-sec-pro.com,https://app.cyber-sec-pro.com

# ============================================
# AI / LLM Configuration (Optional)
# ============================================
# Set OPENAI_API_KEY to enable LLM-enriched AI features (suggest-tools, playbook, explain).
# Without this, all AI endpoints work offline using the local keyword engine.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Ollama local LLM bridge (ai-bridge.js service on port 8765)
OLLAMA_HOST=http://127.0.0.1:11434
AI_BRIDGE_PORT=8765

# ============================================
# Scan Engine Configuration
# ============================================
SCAN_MAX_WORKERS=4
SCAN_USE_DOCKER=true
SCAN_DEFAULT_TIMEOUT=300

# Agent routing: set to "false" to force all scans to run server-side (ignore agent)
AGENT_ROUTING_ENABLED=true

# ============================================
# Purple Team / Detection Configuration (Optional)
# ============================================
# Set to enable detection signal integration
PURPLE_TEAM_DETECT_ENDPOINT=
PURPLE_TEAM_DETECT_API_KEY=

# ============================================
# Monitoring & Logging
# ============================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
ENABLE_METRICS=true

# ============================================
# Cloudflare Configuration (Optional)
# ============================================
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token
