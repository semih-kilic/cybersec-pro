<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blog - CyberSec Pro | Kali Linux Tutorials & Security News</title>
    <meta name="description" content="Learn about cybersecurity, Kali Linux tools, penetration testing techniques, and security best practices from our expert team.">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'kali': { 'blue': '#367bf0', 'dark': '#1a1a2e', 'darker': '#0f0f1a', 'purple': '#9b59b6', 'cyan': '#00d4ff', 'green': '#2ecc71', 'red': '#e74c3c', 'orange': '#f39c12' }
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; background: #0a0a12; }
        .kali-gradient { background: linear-gradient(135deg, #367bf0 0%, #9b59b6 50%, #367bf0 100%); background-size: 200% 200%; animation: gradientMove 5s ease infinite; }
        @keyframes gradientMove { 0%, 100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }
        .kali-text { background: linear-gradient(135deg, #367bf0, #9b59b6, #00d4ff); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
        .dragon-bg { background: radial-gradient(ellipse 100% 80% at 50% 20%, rgba(54, 123, 240, 0.15), transparent), #0a0a12; }
        .kali-card { background: linear-gradient(145deg, rgba(26, 26, 46, 0.8), rgba(15, 15, 26, 0.9)); border: 1px solid rgba(54, 123, 240, 0.2); transition: all 0.3s ease; }
        .kali-card:hover { border-color: rgba(54, 123, 240, 0.5); transform: translateY(-5px); }
        .btn-kali { background: linear-gradient(135deg, #367bf0 0%, #2563eb 100%); box-shadow: 0 10px 40px rgba(54, 123, 240, 0.4); }
        @keyframes pulse-glow { 0%, 100% { box-shadow: 0 0 0 0 rgba(54, 123, 240, 0.7); } 50% { box-shadow: 0 0 0 15px rgba(54, 123, 240, 0); } }
        .pulse-kali { animation: pulse-glow 2s infinite; }
    </style>
</head>
<body class="text-white antialiased">
    <!-- Navigation -->
    <nav class="sticky top-0 z-50 bg-kali-darker/95 backdrop-blur-xl border-b border-kali-blue/10">
