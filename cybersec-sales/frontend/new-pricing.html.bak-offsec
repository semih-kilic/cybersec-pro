                    <li class="flex items-start gap-2"><span class="text-kali-green mt-0.5">✓</span>PDF report with findings</li>
                    <li class="flex items-start gap-2"><span class="text-kali-green mt-0.5">✓</span>No credit card required</li>
                    <li class="flex items-start gap-2"><span class="text-kali-green mt-0.5">✓</span>Email support</li>
                </ul>
            </div>

            <!-- Starter -->
