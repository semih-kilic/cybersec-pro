<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pricing Plans - CyberSec Pro | €99/mo Cloud Security Platform</title>
    <meta name="description" content="CyberSec Pro pricing: Free Trial, Starter €99/mo, Professional €299/mo, Enterprise €799/mo. 401 Kali Linux tools, cloud-based, no installation. SOC 2 & ISO 27001 certified.">
    <link rel="canonical" href="https://semihkilic.com/new-pricing.html">
    <meta property="og:title" content="CyberSec Pro Pricing - Cloud Security Platform">
    <meta property="og:description" content="Flexible monthly plans starting at €99/mo. 401 Kali Linux tools, compliance reports, API access.">
    <meta property="og:url" content="https://semihkilic.com/new-pricing.html">
    <meta property="og:type" content="website">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'kali-blue': '#367bf0',
                        'kali-dark': '#1a1a2e',
                        'kali-darker': '#0f0f1a',
                        'kali-purple': '#9b59b6',
                        'kali-cyan': '#00d4ff',
                        'kali-green': '#2ecc71',
                        'kali-red': '#e74c3c',
                        'kali-orange': '#f39c12'
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .gradient-bg { background: linear-gradient(135deg, #0f0f1a 0%, #1a1a2e 50%, #0f0f1a 100%); }
        .card-glow { transition: all 0.3s ease; }
        .card-glow:hover { transform: translateY(-4px); box-shadow: 0 0 40px rgba(54,123,240,0.15); }
        .popular-glow { box-shadow: 0 0 60px rgba(54,123,240,0.2); }
    </style>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": "CyberSec Pro",
      "description": "Cloud-based penetration testing platform with 401 Kali Linux security tools",
      "brand": { "@type": "Brand", "name": "CyberSec Pro" },
      "offers": [
        { "@type": "Offer", "name": "Free Trial", "price": "0", "priceCurrency": "EUR", "description": "14-day free trial with all 401 tools" },
        { "@type": "Offer", "name": "Starter", "price": "99", "priceCurrency": "EUR", "priceSpecification": { "@type": "UnitPriceSpecification", "billingDuration": "P1M" } },
        { "@type": "Offer", "name": "Professional", "price": "299", "priceCurrency": "EUR", "priceSpecification": { "@type": "UnitPriceSpecification", "billingDuration": "P1M" } },
        { "@type": "Offer", "name": "Enterprise", "price": "799", "priceCurrency": "EUR", "priceSpecification": { "@type": "UnitPriceSpecification", "billingDuration": "P1M" } }
      ]
    }
    </script>
</head>
<body class="gradient-bg text-white min-h-screen">

    <!-- Header -->
    <header class="container mx-auto px-6 py-6">
