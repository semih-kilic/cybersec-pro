                    <span class="text-xl font-bold text-white">🛡️</span>
                </div>
                <span class="text-2xl font-bold bg-gradient-to-r from-kali-blue to-kali-cyan bg-clip-text text-transparent">CyberSec Pro</span>
            </a>
            <nav class="hidden md:flex items-center space-x-8">
                <a href="/#features" class="hover:text-kali-cyan transition-colors">Features</a>
                <a href="/#tools" class="hover:text-kali-cyan transition-colors">Tools</a>
                <a href="/docs.html" class="hover:text-kali-cyan transition-colors">Docs</a>
                <a href="/contact.html" class="hover:text-kali-cyan transition-colors">Contact</a>
                <a href="/dashboard/login" class="bg-kali-blue hover:bg-blue-600 px-5 py-2 rounded-lg font-semibold transition-colors" id="nav-cta">Start Free Trial</a>
            </nav>
