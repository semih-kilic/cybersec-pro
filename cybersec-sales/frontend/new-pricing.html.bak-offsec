                <ul class="space-y-3 text-sm text-gray-300">
                    <li class="flex items-start gap-2"><span class="text-kali-green mt-0.5">✓</span>All 401 security tools</li>
                    <li class="flex items-start gap-2"><span class="text-kali-green mt-0.5">✓</span>1 domain / application</li>
                    <li class="flex items-start gap-2"><span class="text-kali-green mt-0.5">✓</span>Weekly automated scans</li>
                    <li class="flex items-start gap-2"><span class="text-kali-green mt-0.5">✓</span>PDF & HTML reports</li>
                    <li class="flex items-start gap-2"><span class="text-kali-green mt-0.5">✓</span>Email alerts</li>
                    <li class="flex items-start gap-2"><span class="text-kali-green mt-0.5">✓</span>Email support (48h SLA)</li>
                </ul>
            </div>

            <!-- Professional (Popular) -->
            <div class="bg-gradient-to-b from-kali-blue/10 to-kali-purple/10 border-2 border-kali-blue rounded-2xl p-8 card-glow popular-glow relative">
                <div class="absolute -top-3.5 left-1/2 -translate-x-1/2">
                    <span class="bg-kali-blue text-white font-bold px-4 py-1 rounded-full text-xs tracking-wide">MOST POPULAR</span>
                </div>
                <h3 class="text-xl font-bold mb-1">Professional</h3>
                <p class="text-gray-400 text-sm mb-6">For teams & consultancies</p>
                <div class="mb-6">
                    <span class="text-4xl font-bold bg-gradient-to-r from-kali-blue to-kali-cyan bg-clip-text text-transparent price-professional">€299</span>
                    <span class="text-gray-400 text-sm"> /month</span>
                </div>
                <button onclick="checkout('professional')" class="block w-full text-center bg-gradient-to-r from-kali-blue to-kali-purple hover:opacity-90 text-white font-semibold py-3 rounded-lg transition-all mb-8">Start Professional</button>
                <ul class="space-y-3 text-sm text-gray-300">
                    <li class="flex items-start gap-2"><span class="text-kali-green mt-0.5">✓</span>All 401 security tools</li>
                    <li class="flex items-start gap-2"><span class="text-kali-green mt-0.5">✓</span>Up to 5 domains</li>
                    <li class="flex items-start gap-2"><span class="text-kali-green mt-0.5">✓</span>Daily automated scans</li>
                    <li class="flex items-start gap-2"><span class="text-kali-green mt-0.5">✓</span>Compliance reports (SOC 2, ISO 27001, GDPR)</li>
                    <li class="flex items-start gap-2"><span class="text-kali-green mt-0.5">✓</span>Full API access</li>
                    <li class="flex items-start gap-2"><span class="text-kali-green mt-0.5">✓</span>CI/CD integration</li>
                    <li class="flex items-start gap-2"><span class="text-kali-green mt-0.5">✓</span>Priority support (24h SLA)</li>
                </ul>
            </div>

            <!-- Enterprise -->
            <div class="bg-kali-dark/80 border border-gray-700/50 rounded-2xl p-8 card-glow">
                <h3 class="text-xl font-bold mb-1">Enterprise</h3>
                <p class="text-gray-400 text-sm mb-6">For large organizations</p>
                <div class="mb-6">
                    <span class="text-4xl font-bold price-enterprise">€799</span>
                    <span class="text-gray-400 text-sm"> /month</span>
                </div>
                <button onclick="checkout('enterprise')" class="block w-full text-center bg-gradient-to-r from-kali-purple to-kali-red hover:opacity-90 text-white font-semibold py-3 rounded-lg transition-all mb-8">Contact Sales</button>
                <ul class="space-y-3 text-sm text-gray-300">
                    <li class="flex items-start gap-2"><span class="text-kali-green mt-0.5">✓</span>All 401 security tools</li>
                    <li class="flex items-start gap-2"><span class="text-kali-green mt-0.5">✓</span>Unlimited domains</li>
                    <li class="flex items-start gap-2"><span class="text-kali-green mt-0.5">✓</span>Continuous monitoring (hourly)</li>
                    <li class="flex items-start gap-2"><span class="text-kali-green mt-0.5">✓</span>All compliance reports (HIPAA, PCI DSS)</li>
                    <li class="flex items-start gap-2"><span class="text-kali-green mt-0.5">✓</span>SSO / SAML / OAuth</li>
                    <li class="flex items-start gap-2"><span class="text-kali-green mt-0.5">✓</span>Dedicated account manager</li>
                    <li class="flex items-start gap-2"><span class="text-kali-green mt-0.5">✓</span>24/7 priority support (2h SLA)</li>
                    <li class="flex items-start gap-2"><span class="text-kali-green mt-0.5">✓</span>99.9% uptime SLA</li>
                </ul>
            </div>
        </div>

        <!-- Trust badges -->
        <div class="flex flex-wrap justify-center gap-6 mt-16 text-gray-400 text-sm">
            <span class="flex items-center gap-2">🔒 SOC 2 Type II</span>
            <span class="flex items-center gap-2">📋 ISO 27001</span>
            <span class="flex items-center gap-2">🇪🇺 GDPR</span>
            <span class="flex items-center gap-2">🏥 HIPAA</span>
            <span class="flex items-center gap-2">💳 PCI DSS</span>
        </div>
    </section>

    <!-- Feature Comparison -->
    <section class="container mx-auto px-6 py-16 border-t border-gray-800">
        <h2 class="text-3xl font-bold text-center mb-12">Compare Plans</h2>
        <div class="max-w-5xl mx-auto overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-gray-700">
                        <th class="text-left py-4 px-3 text-gray-400 font-medium">Feature</th>
                        <th class="py-4 px-3 text-center">Free Trial</th>
                        <th class="py-4 px-3 text-center">Starter</th>
                        <th class="py-4 px-3 text-center text-kali-blue font-bold">Professional</th>
                        <th class="py-4 px-3 text-center">Enterprise</th>
                    </tr>
                </thead>
                <tbody class="text-gray-300">
                    <tr class="border-b border-gray-800"><td class="py-3 px-3">Security Tools</td><td class="text-center">401</td><td class="text-center">401</td><td class="text-center">401</td><td class="text-center">401</td></tr>
                    <tr class="border-b border-gray-800"><td class="py-3 px-3">Domains / Apps</td><td class="text-center">1</td><td class="text-center">1</td><td class="text-center">5</td><td class="text-center">Unlimited</td></tr>
                    <tr class="border-b border-gray-800"><td class="py-3 px-3">Scan Frequency</td><td class="text-center">1 scan</td><td class="text-center">Weekly</td><td class="text-center">Daily</td><td class="text-center">Continuous</td></tr>
                    <tr class="border-b border-gray-800"><td class="py-3 px-3">Reports (PDF/HTML)</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td><td class="text-center">✓</td></tr>
                    <tr class="border-b border-gray-800"><td class="py-3 px-3">Compliance Reports</td><td class="text-center">—</td><td class="text-center">—</td><td class="text-center">✓</td><td class="text-center">✓</td></tr>
                    <tr class="border-b border-gray-800"><td class="py-3 px-3">API Access</td><td class="text-center">—</td><td class="text-center">—</td><td class="text-center">✓</td><td class="text-center">✓</td></tr>
                    <tr class="border-b border-gray-800"><td class="py-3 px-3">CI/CD Integration</td><td class="text-center">—</td><td class="text-center">—</td><td class="text-center">✓</td><td class="text-center">✓</td></tr>
                    <tr class="border-b border-gray-800"><td class="py-3 px-3">SSO / SAML</td><td class="text-center">—</td><td class="text-center">—</td><td class="text-center">—</td><td class="text-center">✓</td></tr>
                    <tr class="border-b border-gray-800"><td class="py-3 px-3">Dedicated Support</td><td class="text-center">—</td><td class="text-center">—</td><td class="text-center">—</td><td class="text-center">✓</td></tr>
                    <tr class="border-b border-gray-800"><td class="py-3 px-3">Uptime SLA</td><td class="text-center">—</td><td class="text-center">99%</td><td class="text-center">99.5%</td><td class="text-center">99.9%</td></tr>
                </tbody>
            </table>
        </div>
    </section>

    <!-- FAQ -->
    <section class="container mx-auto px-6 py-16 border-t border-gray-800">
        <h2 class="text-3xl font-bold text-center mb-12">Frequently Asked Questions</h2>
        <div class="max-w-3xl mx-auto space-y-6">
            <div class="bg-kali-dark/60 border border-gray-700/50 rounded-xl p-6">
                <h3 class="font-semibold mb-2">Can I cancel anytime?</h3>
                <p class="text-gray-400 text-sm">Yes. All plans are month-to-month with no long-term commitment. Cancel anytime and keep access until the end of your billing cycle.</p>
            </div>
            <div class="bg-kali-dark/60 border border-gray-700/50 rounded-xl p-6">
                <h3 class="font-semibold mb-2">Do you offer annual discounts?</h3>
                <p class="text-gray-400 text-sm">Yes — save 17% when you choose annual billing. Toggle the switch above to see annual prices.</p>
            </div>
            <div class="bg-kali-dark/60 border border-gray-700/50 rounded-xl p-6">
                <h3 class="font-semibold mb-2">What payment methods do you accept?</h3>
                <p class="text-gray-400 text-sm">We accept all major credit cards (Visa, Mastercard, Amex), SEPA direct debit, and wire transfers for Enterprise accounts.</p>
            </div>
            <div class="bg-kali-dark/60 border border-gray-700/50 rounded-xl p-6">
                <h3 class="font-semibold mb-2">Is there a money-back guarantee?</h3>
                <p class="text-gray-400 text-sm">Yes — 30-day money-back guarantee on all paid plans. No questions asked.</p>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="container mx-auto px-6 py-20 text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Ready to Secure Your Infrastructure?</h2>
        <p class="text-gray-400 mb-8 max-w-xl mx-auto">Start your 14-day free trial today. No credit card required. Access all 401 tools instantly.</p>
        <a href="/dashboard/login" class="inline-block bg-gradient-to-r from-kali-blue to-kali-purple hover:opacity-90 text-white font-bold py-4 px-10 rounded-lg text-lg transition-all">Start Free Trial →</a>
    </section>

    <!-- Footer -->
    <footer class="border-t border-gray-800 py-10">
        <div class="container mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-4">
            <div class="flex items-center space-x-3">
                <div class="w-8 h-8 bg-gradient-to-r from-kali-blue to-kali-purple rounded-lg flex items-center justify-center">
                    <span class="text-sm">🛡️</span>
                </div>
                <span class="font-bold bg-gradient-to-r from-kali-blue to-kali-cyan bg-clip-text text-transparent">CyberSec Pro</span>
            </div>
            <div class="flex space-x-6 text-sm text-gray-400">
                <a href="/privacy.html" class="hover:text-white">Privacy</a>
                <a href="/terms.html" class="hover:text-white">Terms</a>
                <a href="/security.html" class="hover:text-white">Security</a>
                <a href="mailto:cybersecpro@semihkilic.com" class="hover:text-white">Contact</a>
            </div>
            <p class="text-gray-500 text-sm">© 2026 CyberSec Pro. All rights reserved.</p>
        </div>
    </footer>

    <script>
        let isAnnual = false;
        const prices = { starter: { monthly: 99, annual: 82 }, professional: { monthly: 299, annual: 249 }, enterprise: { monthly: 799, annual: 665 } };

        function toggleBilling() {
            isAnnual = !isAnnual;
            document.getElementById('toggle-dot').style.transform = isAnnual ? 'translateX(28px)' : 'translateX(0)';
            document.getElementById('billing-toggle').style.background = isAnnual ? '#367bf0' : '';
            document.getElementById('label-monthly').style.color = isAnnual ? '#888' : '#fff';
            document.getElementById('label-annual').style.color = isAnnual ? '#fff' : '#888';

            for (const [plan, p] of Object.entries(prices)) {
                const el = document.querySelector('.price-' + plan);
                if (el) el.textContent = '€' + (isAnnual ? p.annual : p.monthly);
            }
        }

        function checkout(plan) {
            if (plan === 'enterprise') {
                window.location.href = 'mailto:cybersecpro@semihkilic.com?subject=Enterprise%20Plan%20Inquiry';
                return;
            }
            const p = prices[plan];
            const body = JSON.stringify({ plan, billing: isAnnual ? 'annual' : 'monthly', price: isAnnual ? p.annual : p.monthly });
            fetch('/api/create-checkout-session', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body
            }).then(r => r.json()).then(d => {
                if (d.url) window.location.href = d.url;
            }).catch(() => {
                window.location.href = '/dashboard/login';
            });
        }

        // Auth-aware nav
        (async () => {
            try {
                const token = localStorage.getItem('token');
                if (token) {
                    const res = await fetch('/api/v1/auth/me', { headers: { 'Authorization': 'Bearer ' + token } });
                    if (res.ok) {
                        document.getElementById('nav-cta').textContent = 'Dashboard';
                        document.getElementById('nav-cta').href = '/dashboard/';
                    }
                }
            } catch(e) {}
        })();
    </script>
    <script src="/js/live-chat.js"></script>
</body>
</html>