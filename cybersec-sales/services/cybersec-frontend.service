[Unit]
Description=CyberSec Pro Static Frontend Server
After=network.target

[Service]
Type=simple
User=sam
WorkingDirectory=/home/sam/APPS/cybersec-sales/frontend
ExecStart=/usr/bin/python3 -m http.server 8080
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
