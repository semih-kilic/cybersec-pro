[Unit]
Description=CyberSec Pro Sales API (Stripe)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=sam
WorkingDirectory=/home/sam/APPS/cybersec-sales/backend
Environment="PATH=/home/sam/APPS/cybersec-sales/backend/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="DOMAIN=https://semihkilic.com"
Environment="ADMIN_TOKEN=cybersec-admin-2026"
# Uncomment and set your email credentials:
# Environment="EMAIL_USER=cybersecpro@semihkilic.com"
# Environment="EMAIL_PASS=your-gmail-app-password"
# Environment="ALERT_EMAIL=semihkilic@gmail.com"
# Environment="STRIPE_WEBHOOK_SECRET=whsec_xxx"
ExecStart=/home/sam/APPS/cybersec-sales/backend/venv/bin/python app.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Notify when service fails
OnFailure=cybersec-alert@%n.service

[Install]
WantedBy=multi-user.target
