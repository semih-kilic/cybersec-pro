[Unit]
Description=CyberSec Pro Site Monitor
After=network.target

[Service]
Type=simple
User=sam
WorkingDirectory=/home/sam/APPS/cybersec-sales/backend
Environment=PATH=/home/sam/APPS/cybersec-sales/backend/venv/bin:/usr/bin:/bin
ExecStart=/home/sam/APPS/cybersec-sales/backend/venv/bin/python3 /home/sam/APPS/cybersec-sales/backend/site_monitor.py --interval 60
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
