# CyberSec Pro - Demo Video Pipeline Configuration
# Copy to .env and fill in your credentials

# ── App Demo Credentials ──
DEMO_BASE_URL=https://cybersecpro.semihkilic.com
DEMO_EMAIL=demo@semihkilic.com
DEMO_PASSWORD=demo123!

# ── YouTube Upload (Google OAuth2) ──
# 1. Create project at https://console.cloud.google.com/
# 2. Enable "YouTube Data API v3"
# 3. Create OAuth 2.0 client credentials (Desktop app)
# 4. Get refresh token via https://developers.google.com/oauthplayground/
#    - Scope: https://www.googleapis.com/auth/youtube.upload
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# ── Vimeo Upload ──
# Get token at https://developer.vimeo.com/apps
# Requires "Upload" scope
VIMEO_TOKEN=
