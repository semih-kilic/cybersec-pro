# Normalise line endings across platforms.
* text=auto eol=lf

# Binary assets — never diff or merge these as text.
*.png  binary
*.gif  binary
*.jpg  binary
*.svg  binary
*.woff2 binary
*.pdf  binary
*.rdb  binary

# ── GitHub language statistics ──────────────────────────────────────────────
# This is a TypeScript + Rust project. The few HTML files are either build
# boilerplate or documentation, not hand-written application code, so they are
# excluded from the language bar.

# Vite's entry template — boilerplate, not application source.
saas-frontend/index.html   linguist-generated=true

# Documentation and status pages rendered as HTML.
docs/**/*.html             linguist-documentation=true
status/**/*.html           linguist-documentation=true
saas-frontend/public/docs.html linguist-documentation=true

# Generated build output (kept out of git, declared here to stay safe if it
# ever gets committed by accident).
frontend/out/**            linguist-generated=true
**/dist/**                 linguist-generated=true
**/target/**               linguist-generated=true

# Lockfiles are generated, not authored.
*.lock                     linguist-generated=true
package-lock.json          linguist-generated=true
Cargo.lock                 linguist-generated=true

# Vendored third-party assets.
**/node_modules/**         linguist-vendored=true
