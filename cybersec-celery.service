[Unit]
Description=CyberSec Pro Celery Worker (Scan Tasks)
Documentation=https://semihkilic.com/docs
After=network.target redis.service cybersec-api.service
Requires=redis.service

[Service]
Type=forking
User=cybersec
Group=cybersec
WorkingDirectory=/home/cybersec/cybersec-pro/saas-backend
Environment="PATH=/home/cybersec/cybersec-pro/saas-backend/venv/bin"
Environment="FLASK_ENV=production"

# Celery worker configuration
# -c 4 = 4 concurrent tasks (scan operations)
# --max-tasks-per-child=50 = restart worker after 50 tasks (memory management)
ExecStart=/home/cybersec/cybersec-pro/saas-backend/venv/bin/celery \
    -A celery_tasks worker \
    --loglevel=info \
    --concurrency=4 \
    --max-tasks-per-child=50 \
    --pidfile=/tmp/celery-cybersec.pid \
    --logfile=/home/cybersec/cybersec-pro/logs/celery-worker.log \
    --detach

ExecStop=/bin/kill -s TERM $(cat /tmp/celery-cybersec.pid)
ExecReload=/bin/kill -s HUP $(cat /tmp/celery-cybersec.pid)
Restart=always
RestartSec=10

# Resource limits
# 4 workers × ~200MB each = ~800MB max for scans
MemoryMax=1500M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
